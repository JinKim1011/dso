{
  "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-sql"],
  "overrides": [
    {
      "files": "*.sql",
      "options": {
        "language": "postgresql"
      }
    }
  ],
  "printWidth": 90,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always"
}
