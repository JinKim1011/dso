{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./type": {
      "types": "./type.ts",
      "default": "./type.ts"
    },
    "./validation/*": {
      "types": "./validation/*.ts",
      "default": "./validation/*.ts"
    },
    "./token-kind": {
      "types": "./token-kind.ts",
      "default": "./token-kind.ts"
    },
    "./operation": {
      "types": "./operation.ts",
      "default": "./operation.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "check-fixtures": "tsc -p fixtures/tsconfig.fixtures.json"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "typescript": "5.9.2"
  }
}
